# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Alpaca ────────────────────────────────────────────────────────────────────
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_PAPER=true          # true = paper trading, false = live

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ── Trading profile (optional overrides) ─────────────────────────────────────
# MAX_TRADES_PER_WEEK=3
# MAX_RISK_PER_TRADE=150.0
# PROFIT_TARGET_PCT=0.70     # 70% gain on premium → exit
# STOP_LOSS_PCT=0.35         # 35% loss on premium → exit
# ACCOUNT_SIZE=2000.0
# MIN_DTE=5
# MAX_DTE=14
